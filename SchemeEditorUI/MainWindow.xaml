<Window
    x:Class="SchemeEditorUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SchemeEditorUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SchemeEditorUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:SchemeModel;assembly=SchemeModel"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <StackPanel Orientation="Horizontal">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                Grid.Row="0"
                d:ItemsSource="{d:SampleData ItemCount=2}"
                ItemsSource="{Binding DataSource}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBox VerticalAlignment="Center" Text="{Binding Name}" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock>X</TextBlock>
                                    <TextBox Text="{Binding PositionX}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock>Y</TextBlock>
                                    <TextBox Text="{Binding PositionY}" />
                                </StackPanel>
                            </StackPanel>
                            <Button>Remove</Button>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button
                x:Name="AddBtn"
                Grid.Row="1"
                Command="{Binding ShowAddPanelCommand}"
                Content="Добавить"/>

            <Popup
                x:Name="AddPanel"
                IsOpen="{Binding IsPanelVisible, Mode=OneWay}"
                Placement="Top"
                PlacementTarget="{Binding ElementName=AddBtn}"
                StaysOpen="False">
                <Border
                    Background="White"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <StackPanel>
                        <Button
                            Command="{Binding AddShapeCommand}"
                            CommandParameter="{x:Type model:Circle}"
                            Content="Круг" />
                        <Button
                            Command="{Binding AddShapeCommand}"
                            CommandParameter="{x:Type model:Square}"
                            Content="Квадрат"/>
                        <Button
                            Command="{Binding AddShapeCommand}"
                            CommandParameter="{x:Type model:Diamond}"
                            Content="Ромб" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>


        <ItemsControl ItemsSource="{Binding DataSource}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:ShapeControl />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding PositionX}" />
                    <Setter Property="Canvas.Top" Value="{Binding PositionY}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </StackPanel>
</Window>
