<Window
    x:Class="SchemeEditorUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SchemeEditorUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SchemeEditorUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:SchemeModel;assembly=SchemeModel"
    Title="{Binding CurrentFilePath}"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Command="{Binding NewFileCommand}" Header="_Создать" />
                <MenuItem Command="{Binding OpenFileCommand}" Header="_Открыть" />
                <MenuItem Command="{Binding SaveFileCommand}" Header="_Сохранить" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    Grid.Row="0"
                    d:ItemsSource="{d:SampleData ItemCount=2}"
                    ItemsSource="{Binding DataSource}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="1" 
                                         VerticalAlignment="Center" 
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="4"/>
                                <StackPanel Grid.Column="2"
                                            Margin="4">
                                    <StackPanel Margin="2" Orientation="Horizontal">
                                        <TextBlock>X</TextBlock>
                                        <TextBox Width="50" HorizontalContentAlignment="Stretch" Text="{Binding PositionX, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="2" Orientation="Horizontal">
                                        <TextBlock>Y</TextBlock>
                                        <TextBox Width="50" Text="{Binding PositionY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsActive}" 
                                          Margin="4"/>
                                <Button
                                    Grid.Column="3"
                                    Command="{Binding DataContext.RemoveShapeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Content="Удалить" 
                                    Margin="4"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button
                    x:Name="AddBtn"
                    Grid.Row="1"
                    Command="{Binding ShowAddPanelCommand}"
                    Content="Добавить" />

                <Popup
                    x:Name="AddPanel"
                    IsOpen="{Binding IsPanelVisible}"
                    Placement="Top"
                    PlacementTarget="{Binding ElementName=AddBtn}"
                    StaysOpen="False">
                    <Border
                        Background="White"
                        BorderBrush="Gray"
                        BorderThickness="1">
                        <StackPanel>
                            <Button
                                Command="{Binding AddShapeCommand}"
                                CommandParameter="{x:Type model:Circle}"
                                Content="Круг" />
                            <Button
                                Command="{Binding AddShapeCommand}"
                                CommandParameter="{x:Type model:Square}"
                                Content="Квадрат" />
                            <Button
                                Command="{Binding AddShapeCommand}"
                                CommandParameter="{x:Type model:Diamond}"
                                Content="Ромб" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"/>

            <ItemsControl Grid.Column="2" ItemsSource="{Binding DataSource}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ShapeControl />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding PositionX}" />
                        <Setter Property="Canvas.Top" Value="{Binding PositionY}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Grid>
    </DockPanel>
</Window>
